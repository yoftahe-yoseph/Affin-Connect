# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for @vis.gl/react-google-maps.
# AI Studio injects the provisioned Maps API key at runtime.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Live Email Dispatch (Resend or SMTP). When omitted, server logs formatted welcome-back emails cleanly.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Hawasa Gebeya <no-reply@hawasagebeya.et>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Hawasa Gebeya <no-reply@hawasagebeya.et>"

# Ethiopian Payment Gateways (Server-side only — never expose secrets in client VITE_* vars)
# Telebirr Merchant In-App / Web Checkout
# TELEBIRR_BASE_URL=""
# TELEBIRR_APP_ID=""
# TELEBIRR_APP_SECRET=""
# TELEBIRR_MERCHANT_CODE=""
# TELEBIRR_PRIVATE_KEY=""

# Commercial Bank of Ethiopia (CBE / CBE Birr Merchant API)
# CBE_BASE_URL=""
# CBE_MERCHANT_ID=""
# CBE_API_KEY=""
# CBE_WEBHOOK_SECRET=""

# Chapa Payment Gateway (ETB Checkout & Webhook Verification)
# CHAPA_SECRET_KEY=""
# CHAPA_WEBHOOK_SECRET=""

